<?xml version="1.0" encoding="utf-8"?>
<!--
    The HeatMind trace, redrawn as a vector at adaptive-icon scale.

    The web mark (frontend/public/icon.svg) is a 40x40 artboard; an adaptive icon is
    108x108 with only the central 72x72 guaranteed visible, so the path is scaled to
    sit inside that safe zone rather than being cropped by a circular mask.

    The gradient runs teal -> amber -> red: the app's own heat ramp, cool to hot.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.35"
        android:scaleY="1.35"
        android:translateX="27"
        android:translateY="27">
        <path
            android:pathData="M7,24h7l3,-9l5,15l3,-8h8"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:strokeColor">
                <gradient
                    android:startX="7"
                    android:startY="30"
                    android:endX="33"
                    android:endY="15"
                    android:type="linear">
                    <item android:offset="0" android:color="#FF2DD4BF" />
                    <item android:offset="0.55" android:color="#FFFACC15" />
                    <item android:offset="1" android:color="#FFEF4444" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
