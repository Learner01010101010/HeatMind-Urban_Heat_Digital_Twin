# Server-side credentials. Copy to .env and restart the backend after editing.
# .env is gitignored; nothing here ever reaches the browser.

# ── Live traffic ──────────────────────────────────────────────────────────
# Two free providers. Set ONE; TomTom wins if both are present. Without either,
# the twin keeps its modelled Pune congestion curve and says so rather than
# reporting a reading it does not have.
#
#   TomTom  2,500 requests/day free, no card   https://developer.tomtom.com
#   HERE    1,000 requests/day free, no card   https://platform.here.com
HEATMIND_TOMTOM_KEY=
HEATMIND_HERE_KEY=
# "tomtom" | "here". Leave blank to pick whichever key is set.
HEATMIND_TRAFFIC_PROVIDER=
# Stay below the free monthly allowance. Use one backend worker.
HEATMIND_TRAFFIC_MONTHLY_LIMIT=18000

# ── Street-level photos for water stops (optional) ────────────────────────
HEATMIND_MAPILLARY_TOKEN=

# Local journey recommendations (install Ollama, then ollama pull qwen3:4b).
HEATMIND_OLLAMA_URL=http://127.0.0.1:11434
HEATMIND_ADVICE_MODEL=qwen3:4b
# Optional extended thinking; slower hardware may exceed the request deadline.
HEATMIND_ADVICE_THINK=0

# Optional navigation suggestions. Each traveller must also enable them in guidance.
HEATMIND_DYNAMIC_REROUTE_ENABLED=1
REROUTE_CHECK_INTERVAL_SECONDS=60
REROUTE_TIME_SAVING_MIN=5
REROUTE_HEAT_IMPROVEMENT_PERCENT=15
REROUTE_HEAT_DOSE_REDUCTION_MIN=5
REROUTE_MAX_EXTRA_MINUTES=5
REROUTE_CONTINUE_COOLDOWN_SECONDS=300
# Optional XGBoost runtime/models; missing or disabled means physics/traffic fallback.
HEATMIND_XGBOOST_ENABLED=1
HEATMIND_XGBOOST_MODEL_DIR=data/ml
