# Server-side credentials. Copy to .env and restart the backend after editing.
# .env is gitignored; nothing here ever reaches the browser.

# ── Live traffic ──────────────────────────────────────────────────────────
# Two free providers. Set ONE; TomTom wins if both are present. Without either,
# the twin keeps its modelled Pune congestion curve and says so rather than
# reporting a reading it does not have.
#
#   TomTom  2,500 requests/day free, no card   https://developer.tomtom.com
#   HERE    1,000 requests/day free, no card   https://platform.here.com
HEATMIND_TOMTOM_KEY=
HEATMIND_HERE_KEY=
# "tomtom" | "here". Leave blank to pick whichever key is set.
HEATMIND_TRAFFIC_PROVIDER=
# Stay below the free monthly allowance. Use one backend worker.
HEATMIND_TRAFFIC_MONTHLY_LIMIT=18000

# ── Street-level photos for water stops (optional) ────────────────────────
HEATMIND_MAPILLARY_TOKEN=
