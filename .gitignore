# Python
backend/.venv/
__pycache__/
*.pyc
backend/data/*.sqlite3

# Node / Next
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/AGENTS.md
frontend/CLAUDE.md
*.tsbuildinfo

# misc
backend.log
.env
.env.local
.DS_Store
.tools/

# generated by postinstall (copied from node_modules)
frontend/public/maplibre/

# Derived sky-view-factor cache (recomputed from zone.json in ~0.6 s on first boot)
backend/data/svf.npy
backend/data/svf.meta.json

# Derived from osm_raw.json by services.osm_ingest.build_zone() on first boot, and
# large enough for the Pune-wide extract that it does not belong in git.
backend/data/zone.json
backend/data/traffic_usage.json
backend/data/traffic_usage.tmp
# Per-tile Overpass cache, fetched on demand for whichever corridor is requested.
backend/data/osm_tiles/

# Raster tile caches for the satellite build steps. Fetched by range request from
# Google Open Buildings 2.5D and the Meta/WRI canopy map; ~270 MB and reproducible
# by rerunning scripts/fetch_buildings.py and scripts/fetch_canopy.py.
backend/data/ob25d_tiles/
backend/data/_win_*.npy
# Intermediate Overture pull; buildings.json is the product of it and is committed.
backend/data/overture_buildings.json
